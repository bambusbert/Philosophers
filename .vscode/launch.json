{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Philosophers",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/philo/philo",
            //"args": ["4", "400", "150", "150"],
            // "args": ["4", "400", "150", "150"],
            "args": ["2", "800", "200", "200", "2147483648"],
            //"args": ["2", "800", "200", "200", "2147483648"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Follow child after fork",
                    "text": "set follow-fork-mode parent",
                    "ignoreFailures": false
                },
                {
                    "description": "Keep both parent and child under debugger control",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "make"
        }
    ]
}
